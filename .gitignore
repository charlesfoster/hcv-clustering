# Pixi environment (installed packages; config.toml is project-specific so track it)
.pixi/*
!.pixi/config.toml

# Python cache
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/

# Downloaded reference data — re-created by `pixi run hcv-cluster refs`
refs/
hcv_refs/

# Test datasets
test_data/

# Workflow outputs — any --outdir starting with "results" (results/, new_results/,
# results_gui/, and any custom name like results_alice/ typed into the GUI)
results/
new_results/
results_*/

# Log files written by the prep stage alongside output prefixes
*.log

# macOS
.DS_Store

# Claude Code project directory
.claude/
