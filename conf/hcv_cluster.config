// Parameters and defaults for the HCV_CLUSTER workflow (see README, 'Running with Nextflow').

params {
    // Release version; selects the container tag. Must equal manifest.version above.
    pipeline_version = "0.2.0"

    // Input / output
    input    = null            // multi-FASTA of consensus sequences (required)
    metadata = null            // optional metadata CSV keyed by sample_id
    outdir   = "results"

    // Where the hcv_cluster Python package lives; null = next to these workflow files. A
    // container profile sets this to the code inside the image.
    code_dir = null

    // Reference data; null = the records bundled in hcv_cluster/data/ (no network needed)
    panel_fasta   = null
    refs_dir      = null
    reference_map = null       // JSON extending/overriding genotype -> accession
    ncbi_email    = null       // only used if --reference_map adds an accession to download

    // Clustering. threshold null = the evidence-based default for the region and metric.
    distance   = "tn93"        // tn93 | snp | both
    region     = null          // null = e1-e2
    threshold  = null
    snp_count_threshold = null
    region_strategy = "fixed"  // fixed | max-usable
    min_coverage    = 0.7
    genotype        = null     // restrict to these subtypes after detection (string or list)
    patient_column  = null     // metadata column identifying the person; sizes clusters by patients
    sample_column   = null     // metadata column identifying the physical sample (cluster_samples)
    duplicate_selection = "region-coverage"  // region-coverage | completeness
    reuse_alignments    = null     // a previous outdir: re-align only new or changed sequences

    // Persistent cluster labels (see README). Read-only unless update_registry is set.
    registry        = null     // directory holding the label registry
    update_registry = false
    label_prefix    = "HCV"
    label_date      = null     // YYYY-MM-DD; null = today

    // Network plots. plot_network: none | html | png | svg | both | all. png/svg need a Chrome
    // install (not present in the container), so html is the portable choice.
    plot_network          = "none"
    plot_scope            = null   // per-genotype | combined | both
    plot_combined_layout  = null   // packed | by-genotype
    plot_node_spacing     = null   // compact | normal | expanded
    plot_color_by         = null   // metadata field names for the options below
    plot_symbol_by        = null
    plot_size_by          = null
    plot_size_order       = null   // list
    plot_outline_by       = null
    plot_center_by        = null
    plot_small_multiple_field = null   // list
    plot_hover_field      = null       // list
    plot_hide_singletons  = false

    // Tools
    mafft    = "mafft"
    tn93     = "tn93"
    minimap2 = "minimap2"

    // Genotyping (minimap2)
    minimap2_preset     = "asm20"
    extra_minimap2_args = ""
    max_secondary       = 50
    min_query_coverage  = 0.50
    min_identity        = 0.75
    close_hit_fraction  = 0.98
    genotype_validation = "auto"   // auto | headers | kmer | none
    genotype_validation_kmer_size = 15

    // TN93
    ambiguities        = "average"
    ambiguity_fraction = null
    min_overlap        = null
    extra_tn93_args    = ""
}

// Resources for the HCV_CLUSTER processes (qualified names, so they only match these).
process {
    withName: "HCV_CLUSTER:PREP_ALIGN" {
        cpus   = 4
        memory = "8 GB"
        time   = "4 h"
    }
    withName: "HCV_CLUSTER:CLUSTER" {
        memory = "8 GB"
    }
}
