// The wrapper's config loads the HCV_CLUSTER defaults, then sets what it wants different.
includeConfig 'hcv-cluster/conf/hcv_cluster.config'

params.source = null
params.outdir = "results"

// Examples of overriding hcv-cluster parameters from the wrapper:
params.patient_column = "patient_index"
// params.registry        = "/data/hcv_label_registry"
// params.update_registry = true
// Containers: set process.container (the image built from hcv-cluster's Dockerfile) and
// params.code_dir = "/opt/hcv-cluster" in a profile, as hcv-cluster's own nextflow.config does.
