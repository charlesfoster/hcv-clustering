manifest {
    name            = "hcv-cluster"
    description     = "HCV genomic clustering for transmission surveillance"
    author          = "Charles Foster"
    version         = "0.2.0"   // keep equal to hcv_cluster/__init__.py (tests/test_release.py)
    nextflowVersion = ">=24.04"
    mainScript      = "main.nf"
}

// All pipeline parameters and their defaults. Another pipeline that includes the HCV_CLUSTER
// workflow loads the same file: includeConfig '<path to hcv-cluster>/conf/hcv_cluster.config'
includeConfig 'conf/hcv_cluster.config'

// Defaults for processes of this pipeline when run on its own. (The settings specific to the
// HCV_CLUSTER processes are in conf/hcv_cluster.config so they travel with the workflow.)
process {
    cpus   = 1
    memory = "4 GB"
    time   = "2 h"
}

profiles {
    // Tools already on PATH, e.g. `pixi run nextflow run main.nf` or a conda environment.
    standard {
        process.executor = "local"
    }

    // Container built from pixi.lock (see docker/Dockerfile): docker build -t hcv-cluster .
    docker {
        docker.enabled  = true
        docker.runOptions = "-u \$(id -u):\$(id -g)"
        process.container = "hcv-cluster:${params.pipeline_version}"  // build: docker build -t hcv-cluster:<version> .
        params.code_dir   = "/opt/hcv-cluster"
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        process.container      = "docker://hcv-cluster:${params.pipeline_version}"
        params.code_dir        = "/opt/hcv-cluster"
    }

    slurm {
        process.executor = "slurm"
    }

    // A tiny run for checking an installation works.
    test {
        params.input = "${projectDir}/assets/test/example.fasta"
    }
}

trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/trace.txt"
    overwrite = true
}
report {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/report.html"
    overwrite = true
}
