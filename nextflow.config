manifest {
    name            = "hcv-cluster"
    description     = "HCV genomic clustering for transmission surveillance"
    author          = "Charles Foster"
    version         = "0.2.0"
    nextflowVersion = ">=24.04"
    mainScript      = "main.nf"
}

params {
    // Input / output
    input    = null            // multi-FASTA of consensus sequences (required)
    metadata = null            // optional metadata CSV keyed by sample_id
    outdir   = "results"

    // Where the Python stages live. A container profile points this at the code in the image.
    code_dir = "${projectDir}"

    // Reference data; null = the records bundled in reference_data/ (no network needed)
    panel_fasta   = null
    refs_dir      = null
    reference_map = null       // JSON extending/overriding genotype -> accession
    ncbi_email    = null       // only used if --reference_map adds an accession to download

    // Clustering. threshold null = the evidence-based default for the region and metric.
    distance   = "tn93"        // tn93 | snp | both
    region     = null          // null = e1-e2
    threshold  = null
    snp_count_threshold = null
    region_strategy = "fixed"  // fixed | max-usable
    min_coverage    = 0.7
    genotype        = null     // restrict to these subtypes after detection (string or list)
    duplicate_selection = "region-coverage"  // region-coverage | completeness

    // Persistent cluster labels (see README). Read-only unless update_registry is set.
    registry        = null     // directory holding the label registry
    update_registry = false
    label_prefix    = "HCV"
    label_date      = null     // YYYY-MM-DD; null = today

    // Tools
    mafft    = "mafft"
    tn93     = "tn93"
    minimap2 = "minimap2"

    // Genotyping (minimap2)
    minimap2_preset     = "asm20"
    extra_minimap2_args = ""
    max_secondary       = 50
    min_query_coverage  = 0.50
    min_identity        = 0.75
    close_hit_fraction  = 0.98
    genotype_validation = "auto"   // auto | headers | kmer | none
    genotype_validation_kmer_size = 15

    // TN93
    ambiguities        = "average"
    ambiguity_fraction = null
    min_overlap        = null
    extra_tn93_args    = ""
}

process {
    cpus   = 1
    memory = "4 GB"
    time   = "2 h"

    withName: "PREP_ALIGN" {
        cpus   = 4
        memory = "8 GB"
        time   = "4 h"
    }
    withName: "CLUSTER" {
        memory = "8 GB"
    }
}

profiles {
    // Tools already on PATH, e.g. `pixi run nextflow run main.nf` or a conda environment.
    standard {
        process.executor = "local"
    }

    // Container built from pixi.lock (see docker/Dockerfile): docker build -t hcv-cluster .
    docker {
        docker.enabled  = true
        docker.runOptions = "-u \$(id -u):\$(id -g)"
        process.container = "hcv-cluster:latest"
        params.code_dir   = "/opt/hcv-cluster"
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        process.container      = "docker://hcv-cluster:latest"
        params.code_dir        = "/opt/hcv-cluster"
    }

    slurm {
        process.executor = "slurm"
    }

    // A tiny run for checking an installation works.
    test {
        params.input = "${projectDir}/assets/test/example.fasta"
    }
}

trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/trace.txt"
    overwrite = true
}
report {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/report.html"
    overwrite = true
}
